---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import { teamMembers } from "../data/people";
---

<Layout title="Team">
  <!-- Hero -->
  <section
    class="relative min-h-[60vh] flex items-center"
    style="padding: 12rem 8vw 6rem;"
  >
    <div class="max-w-4xl">
      <h1
        class="text-display-xl mb-6"
        style={{ color: "var(--sand)", fontWeight: 300 }}
      >
        The people behind<br />the work
      </h1>
      <p
        class="text-body"
        style={{ color: "var(--sand)", opacity: 0.75, maxWidth: "50ch" }}
      >
        A small but mighty team of designers, engineers, and strategists based
        in Helsinki, Finland.
      </p>
    </div>
  </section>

  <!-- Team Grid -->
  <Section background="surface">
    <h2 class="text-display-lg mb-12" style={{ color: "var(--sand)" }}>
      Meet the team
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        teamMembers.map((member, index) => (
          <div
            style={{
              borderTop: "1px solid var(--sand-8)",
              paddingTop: "2rem",
            }}
          >
            <span
              class="text-mono-label block mb-4"
              style={{ color: "var(--amber)" }}
            >
              0{index + 1}
            </span>
            <h3 class="text-title mb-2" style={{ color: "var(--sand)" }}>
              {member.name}
            </h3>
            {member.title && (
              <p class="text-mono-label mb-4" style={{ color: "var(--clay)" }}>
                {member.title}
              </p>
            )}
            {member.keyCompetencies && (
              <div class="flex flex-wrap gap-2 mb-4">
                {member.keyCompetencies.map((comp) => (
                  <Badge size="small">{comp}</Badge>
                ))}
              </div>
            )}
            {member.storyHtml && (
              <div
                class="text-body"
                set:html={member.storyHtml}
                style={{ color: "var(--sand)", opacity: 0.7 }}
              />
            )}
            {member.linkedin && (
              <a
                class="text-mono-label mt-4 inline-block transition-colors duration-300 hover:text-[var(--highlight)] focus:text-[var(--highlight)] focus:outline-none"
                href={member.linkedin}
                rel="noopener noreferrer"
                style={{ color: "var(--clay)" }}
                target="_blank"
              >
                LinkedIn →
              </a>
            )}
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Values (kept from original studio page) -->
  <Section background="void">
    <h2 class="text-display-lg mb-12" style={{ color: "var(--sand)" }}>
      How we work
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <Card number="01" numberColor="clay" title="Remote-first">
        We work from Helsinki, Finland. Results matter more than location.
      </Card>
      <Card number="02" numberColor="clay" title="Collaborative">
        We embed with your team, not alongside it. True partnership produces the
        best work.
      </Card>
      <Card number="03" numberColor="clay" title="Craft-focused">
        Details matter. We take pride in the polish of every deliverable, from
        strategy to pixels.
      </Card>
    </div>
  </Section>

  {/* Trainee Position */}
  <Section background="surface">
    <h2 class="text-display-lg mb-12" style={{ color: "var(--sand)" }}>
      Trainee position
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <Card number="01" title="The role" subtitle="Engineering trainee">
        Web and Flutter development. Build real products for your portfolio.
      </Card>
      <Card
        number="02"
        title="What you'll learn"
        subtitle="AI-assisted development"
      >
        GitHub Copilot and agentic coding. TypeScript, Rust, WebAssembly,
        Flutter.
      </Card>
      <Card number="03" title="The details" subtitle="10–20 weeks, 90% remote">
        Helsinki, Finland.
      </Card>
    </div>

    <div class="mt-8">
      <Button href="/contact">Get in touch</Button>
    </div>
  </Section>
</Layout>
