---
import Layout from "../layouts/Layout.astro";
import { ArrowLeft } from "lucide-react";
import People from "../components/People.astro";
---

<Layout title="Team">
  <section class="pt-32 pb-12 px-4 sm:px-6 lg:px-8 bg-background">
    <div class="max-w-4xl mx-auto text-center">
      <a
        aria-label="Back to home page"
        class="inline-flex items-center mb-8 text-sm text-foreground hover:text-accent-red transition-colors"
        href="/"
      >
        <ArrowLeft className="w-4 h-4 mr-2" />
        Back to Home
      </a>
      <span
        class="inline-block px-4 py-1.5 mb-6 text-sm font-medium bg-secondary text-foreground rounded-full"
      >
        Our Team
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">Meet the experts</h1>
      <p class="text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto">
        A collective of seasoned design leaders and practitioners dedicated to
        elevating digital design in Finland.
      </p>
    </div>
  </section>

  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-background pb-24">
    <div class="max-w-7xl mx-auto">
      <People />
    </div>
  </section>
</Layout>
