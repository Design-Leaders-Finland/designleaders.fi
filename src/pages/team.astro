---
import Layout from "../layouts/Layout.astro";
import { teamMembers } from "../data/people";
---

<Layout title="Team">
  <!-- Hero -->
  <section
    class="relative min-h-[60vh] flex items-center"
    style="padding: 12rem 8vw 6rem;"
  >
    <div class="max-w-4xl">
      <h1
        class="text-display-xl mb-6"
        style={{ color: "var(--sand)", fontWeight: 300 }}
      >
        The people behind<br />the work
      </h1>
      <p
        class="text-body"
        style={{ color: "var(--sand)", opacity: 0.75, maxWidth: "50ch" }}
      >
        A small but mighty team of designers, engineers, and strategists based
        in Copenhagen and beyond.
      </p>
    </div>
  </section>

  <!-- Team Grid -->
  <section style={{ background: "var(--surface)", padding: "6rem 8vw" }}>
    <h2 class="text-display-lg mb-12" style={{ color: "var(--sand)" }}>
      Meet the team
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        teamMembers.map((member, index) => (
          <div
            style={{
              borderTop: "1px solid rgba(243,239,231,0.08)",
              paddingTop: "2rem",
            }}
          >
            <span
              class="text-mono-label block mb-4"
              style={{ color: "var(--amber)" }}
            >
              0{index + 1}
            </span>
            <h3 class="text-title mb-2" style={{ color: "var(--sand)" }}>
              {member.name}
            </h3>
            {member.title && (
              <p class="text-mono-label mb-4" style={{ color: "var(--clay)" }}>
                {member.title}
              </p>
            )}
            {member.keyCompetencies && (
              <div class="flex flex-wrap gap-2 mb-4">
                {member.keyCompetencies.map((comp) => (
                  <span
                    class="text-caption"
                    style={{
                      background: "var(--deep)",
                      color: "var(--sand)",
                      padding: "4px 8px",
                      borderRadius: "2px",
                      opacity: 0.8,
                    }}
                  >
                    {comp}
                  </span>
                ))}
              </div>
            )}
            {member.storyHtml && (
              <div
                class="text-body"
                style={{ color: "var(--sand)", opacity: 0.7 }}
                set:html={member.storyHtml}
              />
            )}
            {member.linkedin && (
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-mono-label mt-4 inline-block transition-colors duration-300 hover:text-[var(--amber)]"
                style={{ color: "var(--clay)" }}
              >
                LinkedIn →
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Values (kept from original studio page) -->
  <section style={{ background: "var(--void)", padding: "6rem 8vw" }}>
    <h2 class="text-display-lg mb-12" style={{ color: "var(--sand)" }}>
      How we work
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <span
          class="text-mono-label block mb-4"
          style={{ color: "var(--clay)" }}>01</span
        >
        <h3 class="text-title mb-3" style={{ color: "var(--sand)" }}>
          Remote-first
        </h3>
        <p class="text-body" style={{ color: "var(--sand)", opacity: 0.7 }}>
          We work from Copenhagen, Helsinki, and everywhere in between. Results
          matter more than location.
        </p>
      </div>
      <div>
        <span
          class="text-mono-label block mb-4"
          style={{ color: "var(--clay)" }}>02</span
        >
        <h3 class="text-title mb-3" style={{ color: "var(--sand)" }}>
          Collaborative
        </h3>
        <p class="text-body" style={{ color: "var(--sand)", opacity: 0.7 }}>
          We embed with your team, not alongside it. True partnership produces
          the best work.
        </p>
      </div>
      <div>
        <span
          class="text-mono-label block mb-4"
          style={{ color: "var(--clay)" }}>03</span
        >
        <h3 class="text-title mb-3" style={{ color: "var(--sand)" }}>
          Craft-focused
        </h3>
        <p class="text-body" style={{ color: "var(--sand)", opacity: 0.7 }}>
          Details matter. We take pride in the polish of every deliverable, from
          strategy to pixels.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section
    class="flex flex-col items-center justify-center text-center"
    style={{
      background: "var(--deep)",
      padding: "8rem 8vw",
      minHeight: "40vh",
    }}
  >
    <p class="text-mono-label mb-4" style={{ color: "var(--clay)" }}>
      Join the team
    </p>
    <h2
      class="text-display-lg mb-6"
      style={{ color: "var(--sand)", fontWeight: 300 }}
    >
      We're hiring
    </h2>
    <p
      class="text-body mb-8"
      style={{ color: "var(--sand)", opacity: 0.6, maxWidth: "40ch" }}
    >
      Always open to meeting talented designers and engineers who care about
      craft.
    </p>
    <a
      href="/contact"
      class="inline-block text-mono-label transition-all duration-300 hover:brightness-110"
      style={{
        background: "var(--amber)",
        color: "var(--void)",
        padding: "14px 28px",
        borderRadius: "2px",
      }}
    >
      Get in touch
    </a>
  </section>
</Layout>
