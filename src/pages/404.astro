---
import Layout from "../layouts/Layout.astro";

// <p>Could not find the address "{document.location.pathname}"</p>
---

<Layout title="Page Not Found">
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8" style={{ background: "var(--void)", minHeight: "60vh" }}>
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4" style={{ color: "var(--sand)" }}>404</h1>
      <p class="text-xl mb-4" style={{ color: "var(--sand)", opacity: 0.7 }}>Oops! Page not found</p>
      <a
        class="text-mono-label underline hover:no-underline focus:no-underline focus:outline-none transition-all"
        href="/"
        style={{ color: "var(--highlight)" }}
      >
        Return to Home
      </a>
    </div>
  </section>
</Layout>
