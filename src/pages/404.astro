---
import Layout from "../layouts/Layout.astro";

// <p>Could not find the address "{document.location.pathname}"</p>
---

<Layout title="Page Not Found">
  <!-- Hero -->
  <section
    class="relative min-h-[50vh] flex items-center"
    style="padding: 12rem 8vw 6rem;"
  >
    <div class="max-w-4xl">
      <h1
        class="text-display-xl mb-6"
        style={{ color: "var(--sand)", fontWeight: 300 }}
      >
        404
      </h1>
      <p
        class="text-body"
        style={{ color: "var(--sand)", opacity: 0.75, maxWidth: "50ch" }}
      >
        Oops! Page not found
      </p>
      <div class="mt-8">
        <a
          class="text-mono-label underline hover:no-underline focus:no-underline focus:outline-none transition-all"
          href="/"
          style={{ color: "var(--highlight)" }}
        >
          Return to Home →
        </a>
      </div>
    </div>
  </section>
</Layout>
