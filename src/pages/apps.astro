---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";

const apps = [
  {
    description: "Real-time public transport tracking for the Helsinki region.",
    name: "Helsinki Transit",
    platforms: ["iOS", "Android"],
  },
  {
    description: "Hyperlocal weather forecasts for Nordic countries.",
    name: "Nordic Weather",
    platforms: ["iOS", "watchOS"],
  },
  {
    description: "Interactive language learning app for Finnish basics.",
    name: "Finnish Learning",
    platforms: ["iOS", "Android", "Web"],
  },
  {
    description: "Component library and design tokens management tool.",
    name: "Design System Kit",
    platforms: ["iOS", "macOS"],
  },
];
---

<Layout title="Apps">
  <!-- Hero -->
  <section
    class="relative min-h-[50vh] flex flex-col items-center justify-center text-center"
    style="padding: 12rem 8vw 6rem;"
  >
    <h1
      class="text-display-xl mb-6"
      style={{ color: "var(--sand)", fontWeight: 300 }}
    >
      Apps we have made
    </h1>
    <p
      class="text-body"
      style={{ color: "var(--sand)", opacity: 0.7, maxWidth: "48ch" }}
    >
      Mobile experiences crafted with care, shipped to app stores worldwide
    </p>
  </section>

  <!-- Apps Grid -->
  <Section background="surface">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        apps.map((app, index) => (
          <div
            style={{
              background: "var(--deep)",
              padding: "2rem",
              borderRadius: "2px",
            }}
          >
            <span
              class="text-mono-label block mb-4"
              style={{ color: "var(--amber)" }}
            >
              0{index + 1}
            </span>
            <h2 class="text-title mb-3" style={{ color: "var(--sand)" }}>
              {app.name}
            </h2>
            <p
              class="text-body mb-4"
              style={{ color: "var(--sand)", opacity: 0.7 }}
            >
              {app.description}
            </p>
            <div class="flex gap-2">
              {app.platforms.map((platform) => (
                <span class="text-mono-label" style={{ color: "var(--clay)" }}>
                  {platform}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <Section
    background="void"
    class="flex flex-col items-center justify-center text-center"
  >
    <h2
      class="text-display-lg mb-6"
      style={{ color: "var(--sand)", fontWeight: 300 }}
    >
      Have an app idea?
    </h2>
    <p class="text-body mb-8" style={{ color: "var(--sand)", opacity: 0.7 }}>
      We can help bring it to life. Let's discuss your vision.
    </p>
    <Button href="/contact">Start a conversation</Button>
  </Section>
</Layout>
