---
import Layout from "../layouts/Layout.astro";
import MainServices from "../components/MainServices.astro";

import { ArrowLeft, ArrowRight } from "lucide-react";
---

<Layout title="Home Page">
  {/* Hero Section */}
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <a
        aria-label="Back to home page"
        class="inline-flex items-center mb-8 text-sm font-medium text-foreground hover:text-accent-red transition-colors"
        href="/"
      >
        <ArrowLeft className="w-4 h-4 mr-2" />
        Back to Home
      </a>
      <h1 class="text-4xl sm:text-5xl font-bold mb-6 text-foreground">
        Our Services
      </h1>
      <p class="text-lg sm:text-xl text-foreground/80 mb-8">
        Comprehensive design consulting services to transform your digital
        products and team capabilities.
      </p>
    </div>
  </section>

  <MainServices />

  {/* CTA Section */}
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6 text-foreground">
        Ready to Transform Your Design Practice?
      </h2>
      <p class="text-lg text-foreground/80 mb-8">
        Let's discuss how our services can help you achieve your design goals.
      </p>
      <a
        aria-label="Get in touch with us"
        class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-accent-red hover:bg-accent-red/90 rounded-lg transition-colors"
        href="/#contact"
      >
        Get in Touch
        <ArrowRight className="ml-2 h-5 w-5" />
      </a>
    </div>
  </section></Layout
>
