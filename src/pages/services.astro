---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";

const services = [
  {
    deliverables: ["Product audits", "Research & insights", "Roadmap planning"],
    description:
      "Product strategy, research, and roadmap planning for ambitious products.",
    title: "Strategy",
  },
  {
    deliverables: ["Design systems", "UI/UX design", "Prototyping"],
    description:
      "UI/UX design systems, interaction design, and visual identity.",
    title: "Design",
  },
  {
    deliverables: ["Frontend dev", "Design systems", "Technical architecture"],
    description:
      "Frontend architecture, React/TypeScript, and design system implementation.",
    title: "Engineering",
  },
  {
    deliverables: ["Team structuring", "Process design", "Hiring support"],
    description:
      "Design team building, process design, and design ops consulting.",
    title: "Leadership",
  },
];
---

<Layout title="Services">
  <!-- Hero -->
  <section
    class="relative min-h-[50vh] flex items-center"
    style="padding: 12rem 8vw 6rem;"
  >
    <div class="max-w-4xl">
      <h1
        class="text-display-xl mb-6"
        style={{ color: "var(--sand)", fontWeight: 300 }}
      >
        What we do
      </h1>
      <p
        class="text-body"
        style={{ color: "var(--sand)", opacity: 0.75, maxWidth: "50ch" }}
      >
        End-to-end product design and strategy for teams who want to move fast
        without breaking things.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <Section background="surface">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        services.map((service, index) => (
          <div
            style={{
              borderTop: "1px solid var(--sand-8)",
              paddingTop: "2rem",
            }}
          >
            <span
              class="text-mono-label block mb-4"
              style={{ color: "var(--amber)" }}
            >
              0{index + 1}
            </span>
            <h2 class="text-display-lg mb-4" style={{ color: "var(--sand)" }}>
              {service.title}
            </h2>
            <p
              class="text-body mb-6"
              style={{ color: "var(--sand)", opacity: 0.7 }}
            >
              {service.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {service.deliverables.map((d) => (
                <Badge>{d}</Badge>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <Section
    background="void"
    class="flex flex-col items-center justify-center text-center"
  >
    <h2
      class="text-display-lg mb-6"
      style={{ color: "var(--sand)", fontWeight: 300 }}
    >
      Ready to start?
    </h2>
    <Button href="/contact">Discuss your project</Button>
  </Section>
</Layout>
