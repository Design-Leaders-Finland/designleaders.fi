---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
---

<Layout title="Privacy Policy">
  <!-- Hero Section -->
  <section
    class="relative min-h-[50vh] flex items-center"
    style="padding: 12rem 8vw 6rem;"
  >
    <div class="max-w-4xl">
      <h1 class="text-display-xl mb-6 sand-heading font-light">
        Privacy Policy
      </h1>
      <p class="text-body sand-text-muted" style="max-width: 50ch;">
        We do not collect, process, store, or share any personal data about you.
        All app functionality operates entirely offline. Your data stays on your
        device only.
      </p>
    </div>
  </section>

  <!-- Core Privacy Principle -->
  <Section background="surface">
    <div class="max-w-4xl">
      <h2 class="text-display-lg mb-6 sand-heading">
        Our Core Privacy Principle
      </h2>
      <p class="text-body mb-4 sand-text-muted font-semibold">
        We do not collect, process, store, or share any personal data about you.
      </p>
      <p class="text-body mb-6 sand-text-muted">
        All app functionality operates entirely offline. Any data you create or
        save within our applications remains exclusively on your device. We do
        not have access to it.
      </p>
      <p class="text-body mb-3 sand-text-muted font-semibold">
        This means we do not:
      </p>
      <ul class="text-body mb-6 pl-6 sand-text-muted" style="list-style: disc;">
        <li>Collect analytics or usage data</li>
        <li>Display advertisements or use ad networks</li>
        <li>Track your behaviour or device usage</li>
        <li>Access your contacts, photos, or other personal content</li>
        <li>Use any third-party services that collect data</li>
        <li>
          Transmit any data from your device to our servers or any other
          location
        </li>
      </ul>
      <p class="text-body sand-text-muted font-semibold">
        Your data stays on your device only.
      </p>
    </div>
  </Section>

  <!-- App Stores -->
  <Section background="void">
    <div class="max-w-4xl">
      <h2 class="text-display-lg mb-6 sand-heading">
        Data Handled by App Stores
      </h2>
      <p class="text-body mb-6 sand-text-muted">
        While we collect no data, the app stores through which you download our
        applications may handle certain information independently of us:
      </p>
      <ul class="text-body mb-6 pl-6 sand-text-muted" style="list-style: disc;">
        <li>
          <strong>Google Play Store</strong> may collect installation metrics and
          payment information for processing your purchase. Their practices are governed
          by <a href="https://policies.google.com/privacy"
            >Google's Privacy Policy</a
          >.
        </li>
        <li>
          <strong>Apple App Store</strong> may collect installation metrics and payment
          information for processing your purchase. Their practices are governed by
          <a href="https://www.apple.com/privacy/privacy-policy/"
            >Apple's Privacy Policy</a
          >.
        </li>
        <li>
          <strong>Microsoft Store</strong> may collect installation metrics and payment
          information for processing your purchase. Their practices are governed by
          <a href="https://privacy.microsoft.com/privacystatement"
            >Microsoft's Privacy Policy</a
          >.
        </li>
      </ul>
      <p class="text-body sand-text-muted">
        We do not receive, access, or control any of this information.
      </p>
    </div>
  </Section>

  <!-- Legal Compliance -->
  <Section background="surface">
    <div class="max-w-4xl">
      <h2 class="text-display-lg mb-6 sand-heading">Legal Compliance</h2>
      <p class="text-body mb-6 sand-text-muted">
        Our privacy practices comply with the following regulations, among
        others:
      </p>
      <ul class="text-body mb-6 pl-6 sand-text-muted" style="list-style: disc;">
        <li>
          <strong
            ><a href="https://gdpr-info.eu/"
              >General Data Protection Regulation (GDPR)</a
            ></strong
          > (EU Regulation 2016/679)
        </li>
        <li>
          <strong
            ><a href="https://ico.org.uk/for-organisations/uk-gdpr/"
              >UK General Data Protection Regulation (UK GDPR)</a
            ></strong
          >
        </li>
        <li>
          <strong
            ><a href="https://www.oikeus.fi/en/index/aboutus/laws.html"
              >Finnish Data Protection Act (Tietosuojalaki 1050/2018)</a
            ></strong
          >
        </li>
        <li>
          <strong
            ><a href="https://oag.ca.gov/privacy/ccpa"
              >California Consumer Privacy Act (CCPA)</a
            ></strong
          >
        </li>
        <li>
          <strong
            ><a
              href="https://www.gov.br/cidadania/pt-br/acesso-a-informacao/lgpd"
              >Brazilian General Data Protection Law (LGPD)</a
            ></strong
          >
        </li>
        <li>
          <strong
            ><a
              href="https://www.priv.gc.ca/en/privacy-topics/privacy-laws-in-canada/the-personal-information-protection-and-electronic-documents-act-pipeda/"
              >Personal Information Protection and Electronic Documents Act
              (PIPEDA)</a
            ></strong
          > (Canada)
        </li>
      </ul>
      <p class="text-body sand-text-muted">
        Since we do not collect or process any personal data, we meet the
        requirements of these regulations by default.
      </p>
    </div>
  </Section>

  <!-- User Rights -->
  <Section background="void">
    <div class="max-w-4xl">
      <h2 class="text-display-lg mb-6 sand-heading">
        Your Rights Under Privacy Laws
      </h2>
      <p class="text-body mb-8 sand-text-muted">
        Even though we hold no personal data about you, the following rights
        apply under applicable privacy laws:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- GDPR and UK GDPR Rights -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            GDPR and UK GDPR Rights
          </h3>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>
              <strong>Right to Access:</strong> You may request information about
              any personal data we hold. We hold none.
            </li>
            <li>
              <strong>Right to Rectification:</strong> You may request correction
              of inaccurate personal data. We hold none to correct.
            </li>
            <li>
              <strong>Right to Erasure:</strong> You may request deletion of your
              personal data. We hold none to delete.
            </li>
            <li>
              <strong>Right to Restrict Processing:</strong> You may request limitation
              of processing. We do not process any personal data.
            </li>
            <li>
              <strong>Right to Data Portability:</strong> You may request your data
              in a portable format. We hold none to provide.
            </li>
            <li>
              <strong>Right to Object:</strong> You may object to processing of your
              data. We do not process any personal data.
            </li>
            <li>
              <strong>Right to Withdraw Consent:</strong> You may withdraw previously
              given consent. We do not rely on consent for processing.
            </li>
          </ul>
        </div>

        <!-- CCPA Rights -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            CCPA Rights (California residents)
          </h3>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>
              <strong>Right to Know:</strong> We do not collect any personal information
              about you.
            </li>
            <li>
              <strong>Right to Delete:</strong> We hold no personal information to
              delete.
            </li>
            <li>
              <strong>Right to Opt-Out of Sale:</strong> We do not sell personal information.
            </li>
            <li>
              <strong>Right to Non-Discrimination:</strong> We do not discriminate
              against users who exercise their privacy rights.
            </li>
          </ul>
        </div>

        <!-- LGPD Rights -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            LGPD Rights (Brazil)
          </h3>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>
              <strong>Right to Access:</strong> We hold no personal data about you.
            </li>
            <li>
              <strong>Right to Rectification:</strong> We hold no personal data to
              correct.
            </li>
            <li>
              <strong>Right to Erasure:</strong> We hold no personal data to delete.
            </li>
            <li>
              <strong>Right to Data Portability:</strong> We hold no personal data
              to provide.
            </li>
            <li>
              <strong>Right to Object:</strong> We do not process any personal data.
            </li>
          </ul>
        </div>

        <!-- PIPEDA Rights -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            PIPEDA Rights (Canada)
          </h3>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>
              <strong>Access to Personal Information:</strong> We hold none.
            </li>
            <li>
              <strong>Challenge Accuracy:</strong> We hold none to challenge.
            </li>
            <li>
              <strong>Withdraw Consent:</strong> Not applicable as we do not process
              data based on consent.
            </li>
          </ul>
        </div>
      </div>

      <p class="text-body mt-8 sand-text-muted">
        To exercise any of these rights, please contact us at [Your privacy
        contact email]. We will respond within 30 days or as required by local
        law.
      </p>
    </div>
  </Section>

  <!-- Additional Sections Grid -->
  <Section background="surface">
    <div class="max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Children's Privacy -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            Children's Privacy
          </h3>
          <p class="text-body sand-text-muted">
            Our applications are not directed at children under 13 years of age
            (or 16 in the European Union and European Economic Area). We do not
            knowingly collect any personal data from children. If you believe we
            have inadvertently collected data from a child, please contact us at
            [Your privacy contact email], and we will take appropriate steps to
            address the issue, including deletion where possible.
          </p>
        </div>

        <!-- Data Security -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            Data Security
          </h3>
          <p class="text-body mb-4 sand-text-muted">
            Since we do not collect, store, or transmit any personal data:
          </p>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>
              There is no risk of data breaches involving your personal
              information
            </li>
            <li>No encryption of personal data in transit is required</li>
            <li>No cloud storage of your personal data occurs</li>
            <li>No server infrastructure processes your personal data</li>
          </ul>
        </div>

        <!-- International Data Transfers -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            International Data Transfers
          </h3>
          <p class="text-body mb-4 sand-text-muted">
            We do not transfer any personal data outside your device. Therefore:
          </p>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>No cross-border data transfers occur</li>
            <li>No adequacy decisions are required</li>
            <li>No Standard Contractual Clauses (SCCs) are necessary</li>
          </ul>
        </div>

        <!-- Data Retention -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            Data Retention
          </h3>
          <p class="text-body sand-text-muted">
            We retain no personal data about you. Any data you create within our
            applications remains on your device until you choose to delete it.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Policy Changes -->
  <Section background="void">
    <div class="max-w-4xl">
      <h2 class="text-display-lg mb-6 sand-heading">
        Changes to This Privacy Policy
      </h2>
      <p class="text-body mb-6 sand-text-muted">
        We may update this Privacy Policy from time to time to reflect:
      </p>
      <ul class="text-body mb-6 pl-6 sand-text-muted" style="list-style: disc;">
        <li>Changes in app store requirements</li>
        <li>Changes in applicable privacy laws</li>
        <li>
          Changes in our data practices (if any are introduced in the future)
        </li>
      </ul>
      <p class="text-body mb-6 sand-text-muted">
        We will notify you of material changes by:
      </p>
      <ul class="text-body mb-6 pl-6 sand-text-muted" style="list-style: disc;">
        <li>Posting the updated policy in our app store listings</li>
        <li>
          Including a notification within the application, if technically
          feasible
        </li>
        <li>Other appropriate means</li>
      </ul>
      <p class="text-body sand-text-muted">
        Your continued use of our applications after such changes constitutes
        acceptance of the revised Privacy Policy.
      </p>
    </div>
  </Section>

  <!-- Contact & Compliance -->
  <Section background="surface">
    <div class="max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Contact -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            How to Contact Us
          </h3>
          <p class="text-body mb-2 sand-text-muted">
            <strong>Design Leaders Finland Oy</strong>
          </p>
          <p class="text-body sand-text-muted">
            Helsinki, Finland<br />
            Email: <a href="mailto:privacy@designleaders.fi"
              >privacy@designleaders.fi</a
            ><br />
            Website: <a href="https://designleaders.fi"
              >https://designleaders.fi</a
            >
          </p>
          <p class="text-body mt-4 sand-text-muted">
            We will respond to your request within 30 days or as required by
            applicable law.
          </p>
        </div>

        <!-- App Store Compliance -->
        <div>
          <h3 class="text-display-md mb-4 sand-heading font-medium">
            App Store Compliance
          </h3>
          <p class="text-body mb-4 sand-text-muted">
            This Privacy Policy meets the requirements of:
          </p>
          <ul class="text-body pl-6 sand-text-muted" style="list-style: disc;">
            <li>
              <strong>Google Play Store:</strong> Privacy policy linked in store listing
              and within the app; Data Safety Form completed with "No data collected"
              for all categories.
            </li>
            <li>
              <strong>Apple App Store:</strong> Privacy policy linked in App Store
              Connect and accessible within the app; "Data Not Collected" selected
              for all categories in the App Privacy section.
            </li>
            <li>
              <strong>Microsoft Store:</strong> Privacy policy linked in Partner Center
              and accessible offline within the app.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .sand-text {
    color: var(--sand);
  }

  .sand-text-muted {
    color: var(--sand);
    opacity: 0.75;
  }

  .sand-heading {
    color: var(--sand);
  }

  .font-medium {
    font-weight: 500;
  }

  .font-semibold {
    font-weight: 600;
  }

  .font-light {
    font-weight: 300;
  }

  :global(a) {
    color: inherit;
  }
</style>
