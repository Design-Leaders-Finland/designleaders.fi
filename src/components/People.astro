---
import { contentfulClient } from "../lib/contentful";
import type { PeopleInfo } from "../lib/contentful";

const entries = await contentfulClient.getEntries<PeopleInfo>({
  content_type: "peopleInformation",
});

// https://www.contentful.com/developers/docs/concepts/links/
const findUrl = (id: string) =>
  entries?.includes?.Asset?.find((asset) => asset.sys.id === id)?.fields?.file
    ?.url;

// All this does is shortens the object chain
const people = entries.items.map((item) => {
  const { title, name, keyCompetencies, story, picture, linkedin } =
    item.fields;
  const pictureUrl = findUrl(picture?.sys.id);
  return {
    title,
    name,
    keyCompetencies,
    story,
    picture: pictureUrl,
    linkedin,
  };
});
---

<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
  {
    people.map((person) => (
      <div class="relative group">
        <div class="relative overflow-hidden rounded-2xl aspect-[3/4]">
          <img
            alt={person.name}
            class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105"
            src={person.picture}
          />
        </div>
        <div class="mt-4">
          <h3 class="text-xl font-semibold">{person.name}</h3>
          <p class="text-accent-sage">{person.title}</p>
          <p class="mt-2 text-gray-600">{person.story}</p>
          <p class="mt-2 text-gray-600">
            <strong>Key Competencies:</strong> {person.keyCompetencies}
          </p>
          <p class="mt-4 flex items-center gap-x-3">
            <a href={person.linkedin} rel="noopener noreferrer" target="_blank">
              LinkedIn Profile
            </a>
          </p>
        </div>
      </div>
    ))
  }
</div>
