---
import { contentfulClient } from "../lib/contentful";
import type { PeopleInfo } from "../lib/contentful";

const entries = await contentfulClient.getEntries<PeopleInfo>({
  content_type: "peopleInformation",
});

// All this does is shortens the object chain
const people = entries.items.map((item) => {
  const { title, name, keyCompetencies, story } = item.fields;
  return {
    title,
    name,
    keyCompetencies,
    story,
  };
});
---

<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
  {
    people.map((person) => (
      <div class="relative group">
        <div class="relative overflow-hidden rounded-2xl aspect-[3/4]">
          <img
            alt={person.name}
            class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105"
            src="https://images.unsplash.com/photo-1581092795360-fd1ca04f0952"
          />
        </div>
        <div class="mt-4">
          <h3 class="text-xl font-semibold">{person.name}</h3>
          <p class="text-accent-sage">{person.title}</p>
          <p class="mt-2 text-gray-600">{person.story}</p>
          <p class="mt-2 text-gray-600">
            <strong>Key Competencies:</strong> {person.keyCompetencies}
          </p>
        </div>
      </div>
    ))
  }
</div>
