---
import Section from "./Section.astro";
import Button from "./Button.astro";
---

<Section
  background="deep"
  padding="large"
  minHeight="60vh"
  class="flex flex-col items-center justify-center text-center"
>
  <h2 class="text-display-xl mb-6 text-sand font-light">
    Let's build something meaningful
  </h2>
  <p class="text-body mb-10 text-sand opacity-70">
    Tell us about your project. We'll respond within 48 hours.
  </p>
  <Button href="/contact" size="large">Start a conversation</Button>
</Section>
