---
// Call-to-action section - simplified
---

<section
  class="flex flex-col items-center justify-center text-center"
  style={{
    background: "var(--deep)",
    padding: "8rem 8vw",
    minHeight: "60vh",
  }}
>
  <h2
    class="text-display-xl mb-6"
    style={{ color: "var(--sand)", fontWeight: 300 }}
  >
    Let's build something meaningful
  </h2>
  <p class="text-body mb-10" style={{ color: "var(--sand)", opacity: 0.6 }}>
    Tell us about your project. We'll respond within 48 hours.
  </p>
  <a
    class="inline-block text-mono-label transition-all duration-300 hover:brightness-110"
    href="/contact"
    style={{
      background: "var(--amber)",
      color: "var(--void)",
      padding: "18px 36px",
      borderRadius: "2px",
    }}
  >
    Start a conversation
  </a>
</section>
