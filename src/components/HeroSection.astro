---
// Simple Astro hero section matching kimi_agent design
---

<section
  class="relative min-h-screen flex items-center"
  style="padding: 12rem 8vw 6rem;"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center w-full"
  >
    <div>
      <h1
        class="text-display-xl mb-6"
        style={{ color: "var(--sand)", fontWeight: 300, lineHeight: 1 }}
      >
        Strategic design<br />
        <span style={{ color: "var(--amber)" }}>&</span> product studio
      </h1>
      <p
        class="text-body mt-6"
        style={{ color: "var(--sand)", opacity: 0.8, maxWidth: "32ch" }}
      >
        Strategy, design, and engineering for forward-thinking teams
      </p>
      <a
        class="inline-block mt-8 text-mono-label transition-all duration-300 hover:brightness-110"
        href="/contact"
        style={{
          background: "var(--amber)",
          color: "var(--void)",
          padding: "14px 28px",
          borderRadius: "2px",
          width: "fit-content",
        }}
      >
        Start a project
      </a>
    </div>
  </div>
</section>
