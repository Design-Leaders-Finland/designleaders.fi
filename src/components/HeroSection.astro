---
import Button from "./Button.astro";
---

<section class="relative min-h-screen flex items-center pt-48 pb-24 px-[8vw]">
  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center w-full"
  >
    <div>
      <h1 class="text-display-xl mb-6 text-sand font-light leading-none">
        Strategic design<br />
        <span class="text-highlight">&</span> product studio
      </h1>
      <p class="text-body mt-6 text-sand opacity-80 max-w-[32ch]">
        Strategy, design, and engineering for forward-thinking teams
      </p>
      <div class="mt-8">
        <Button href="/contact">Start a project</Button>
      </div>
    </div>
  </div>
</section>
