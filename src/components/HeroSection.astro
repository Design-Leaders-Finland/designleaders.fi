---
import Button from "./Button.astro";
---

<section class="relative min-h-screen flex items-center pt-48 pb-24 px-[8vw]">
  <div class="max-w-4xl">
    <h1 class="text-display-xl mb-6 text-sand font-light leading-none">
      <span class="text-highlight">We help businesses to</span>
      reduce design debt<br />
      <span class="text-highlight">and</span>
      ship faster.
    </h1>
    <p class="text-body mt-6 text-sand opacity-80 max-w-[32ch]">
      We help varying sizes of businesses to reduce design and technical debt,
      and to ship faster through our expertise in Design Leadership, Strategy,
      Design Systems, and Design Engineering.
    </p>
    <div class="mt-8">
      <Button href="/contact">Start a project</Button>
    </div>
  </div>
</section>
