---
interface Props {
  background?: "surface" | "void" | "deep";
  padding?: "default" | "large" | "hero";
  minHeight?: string;
  class?: string;
}

const {
  background = "surface",
  padding = "default",
  minHeight,
  class: className = "",
} = Astro.props;

const bgClasses = {
  deep: "bg-deep",
  surface: "bg-surface",
  void: "bg-void",
};

const paddingClasses = {
  default: "pt-24 pb-24 px-[8vw]",
  hero: "pt-48 pb-24 px-[8vw]",
  large: "pt-32 pb-32 px-[8vw]",
};
---

<section
  class={`${className} ${bgClasses[background]} ${paddingClasses[padding]}`}
  style={minHeight ? { minHeight } : undefined}
>
  <slot />
</section>
