---
// Services section - simplified from kimi_agent
const services = [
  {
    title: "Strategy",
    description:
      "Product strategy, research, and roadmap planning for ambitious products.",
  },
  {
    title: "Design",
    description:
      "UI/UX design systems, interaction design, and visual identity.",
  },
  {
    title: "Engineering",
    description:
      "Frontend architecture, React/TypeScript, and design system implementation.",
  },
  {
    title: "Leadership",
    description:
      "Design team building, process design, and design ops consulting.",
  },
];
---

<section style={{ background: "var(--void)", padding: "6rem 8vw" }}>
  <h2 class="text-display-lg mb-12" style={{ color: "var(--sand)" }}>
    Services
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {
      services.map((service, index) => (
        <div
          class="group"
          style={{
            borderTop: "1px solid rgba(243,239,231,0.08)",
            paddingTop: "2rem",
          }}
        >
          <span
            class="text-mono-label block mb-4"
            style={{ color: "var(--amber)" }}
          >
            0{index + 1}
          </span>
          <h3 class="text-title mb-3" style={{ color: "var(--sand)" }}>
            {service.title}
          </h3>
          <p class="text-body" style={{ color: "var(--sand)", opacity: 0.7 }}>
            {service.description}
          </p>
        </div>
      ))
    }
  </div>

  <div class="mt-12 text-center">
    <a
      class="inline-flex items-center gap-2 text-mono-label transition-colors duration-300 hover:text-[var(--amber)]"
      href="/services"
      style={{ color: "var(--clay)" }}
    >
      View all services
      <svg fill="none" height="16" viewBox="0 0 16 16" width="16">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"
        ></path>
      </svg>
    </a>
  </div>
</section>
