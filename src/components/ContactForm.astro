---
import { ArrowRight } from "lucide-react";
---

<section class="py-20 px-4 sm:px-6 lg:px-8 bg-secondary" id="contact">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16">
      <span
        class="inline-block px-4 py-1.5 mb-6 text-sm font-medium bg-accent-red/10 text-accent-red rounded-full"
      >
        Get in Touch
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Start Your Design Journey
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Ready to elevate your design practice? Let's discuss how we can help.
      </p>
    </div>

    <form class="space-y-6" data-netlify="true" method="POST" name="contact">
      <input name="form-name" type="hidden" value="contact" />
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label
            class="block text-sm font-medium text-foreground mb-1"
            for="name"
          >
            Name
          </label>
          <input
            class="w-full px-4 py-3 rounded-lg bg-background border border-input focus:border-accent-red focus:ring-1 focus:ring-accent-red/20 transition-colors"
            id="name"
            name="name"
            required
            type="text"
          />
        </div>
        <div>
          <label
            class="block text-sm font-medium text-foreground mb-1"
            for="email"
          >
            Email
          </label>
          <input
            class="w-full px-4 py-3 rounded-lg bg-background border border-input focus:border-accent-red focus:ring-1 focus:ring-accent-red/20 transition-colors"
            id="email"
            name="email"
            required
            type="email"
          />
        </div>
      </div>
      <div>
        <label
          class="block text-sm font-medium text-foreground mb-1"
          for="message"
        >
          Message
        </label>
        <textarea
          class="w-full px-4 py-3 rounded-lg bg-background border border-input focus:border-accent-red focus:ring-1 focus:ring-accent-red/20 transition-colors"
          id="message"
          name="message"
          required
          rows={4}></textarea>
      </div>
      <div class="text-center">
        <button
          class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-accent-red hover:bg-accent-red/90 rounded-lg transition-colors"
          type="submit"
        >
          Send Message
          <ArrowRight className="ml-2 h-5 w-5" />
        </button>
      </div>
    </form>

    <div
      class="hidden fixed inset-0 flex items-center justify-center bg-black bg-opacity-50"
      id="form-sent-feedback-dialog"
    >
      <div class="bg-black p-8 rounded-lg shadow-lg text-center">
        <h3 class="text-2xl font-semibold mb-4">Thank You!</h3>
        <p class="text-lg mb-6">
          Your message has been sent successfully and we will be contacting you
          soon.
        </p>
        <button
          class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-accent-red hover:bg-accent-red/90 rounded-lg transition-colors"
          id="close-dialog-button"
          type="button"
        >
          Close
        </button>
      </div>
    </div>
    <script is:inline>
      const dialog = document.getElementById("form-sent-feedback-dialog");
      const form = document.querySelector('form[name="contact"]');
      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const formObject = Object.fromEntries(formData.entries());

        fetch("/", {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
          },
          body: new URLSearchParams(formObject).toString(),
        })
          .then(() => {
            dialog.classList.remove("hidden");
          })
          .catch((error) => console.error(error));
      });

      const button = document.getElementById("close-dialog-button");
      button.addEventListener("click", function () {
        dialog.classList.add("hidden");
      });
    </script>
  </div>
</section>
