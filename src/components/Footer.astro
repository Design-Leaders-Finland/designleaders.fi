---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: "/#work", label: "Work" },
  { href: "/services", label: "Services" },
  { href: "/team", label: "Team" },
  { href: "/apps", label: "Apps" },
  { href: "/contact", label: "Contact" },
  { href: "/privacy-policy", label: "Privacy Policy" },
];

const socialLinks = [
  { href: "https://linkedin.com", label: "LinkedIn" },
  { href: "https://dribbble.com", label: "Dribbble" },
  { href: "https://github.com", label: "GitHub" },
];
---

<footer class="bg-deep pt-24 pb-12 px-[8vw]">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
    <!-- Column 1 - Logo & Address -->
    <div>
      <div class="text-base font-medium mb-8 text-sand">
        Design Leaders Finland
      </div>
      <p class="text-caption text-sand opacity-70">Helsinki, Finland</p>
    </div>

    <!-- Column 2 - Navigation -->
    <div class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            class="text-mono-label transition-opacity duration-300 hover:opacity-100 focus:opacity-100 focus:outline-none text-sand opacity-70"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Column 3 - Social -->
    <div class="flex flex-col gap-3">
      {
        socialLinks.map((social) => (
          <a
            class="text-mono-label transition-opacity duration-300 hover:opacity-100 focus:opacity-100 focus:outline-none text-sand opacity-70"
            href={social.href}
            rel="noopener noreferrer"
            target="_blank"
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="flex flex-col md:flex-row justify-between items-center gap-4 mt-16 pt-8 border-t border-sand-8"
  >
    <span class="text-caption text-sand opacity-60">
      &copy; {currentYear} Design Leaders Finland Oy
    </span>
    <span class="text-caption text-sand opacity-60"> Helsinki, Finland </span>
  </div>

  <!-- 365-day color spectrum - populated by JavaScript -->
  <div
    id="footer-spectrum"
    class="w-full mt-8 h-4"
    aria-hidden="true"
    title="Year color cycle: Pink → Violet → Blue → Green → Orange"
  >
  </div>
</footer>
