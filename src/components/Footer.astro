---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: "Work", href: "/#work" },
  { label: "Services", href: "/services" },
  { label: "Team", href: "/team" },
  { label: "Apps", href: "/apps" },
  { label: "Contact", href: "/contact" },
];

const socialLinks = [
  { label: "LinkedIn", href: "https://linkedin.com" },
  { label: "Dribbble", href: "https://dribbble.com" },
  { label: "GitHub", href: "https://github.com" },
];
---

<footer style={{ background: "var(--deep)", padding: "6rem 8vw 3rem" }}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
    <!-- Column 1 - Logo & Address -->
    <div>
      <div
        class="text-base font-medium mb-8"
        style={{ color: "var(--sand)", fontFamily: "'DM Sans', sans-serif" }}
      >
        design leaders
      </div>
      <p class="text-caption" style={{ color: "var(--sand)", opacity: 0.5 }}>
        Sortedam Dossering 59C<br />
        2100 Copenhagen
      </p>
    </div>

    <!-- Column 2 - Navigation -->
    <div class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            class="text-mono-label transition-opacity duration-300 hover:opacity-100"
            href={link.href}
            style={{ color: "var(--sand)", opacity: 0.5 }}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Column 3 - Social -->
    <div class="flex flex-col gap-3">
      {
        socialLinks.map((social) => (
          <a
            class="text-mono-label transition-opacity duration-300 hover:opacity-100"
            href={social.href}
            rel="noopener noreferrer"
            style={{ color: "var(--sand)", opacity: 0.5 }}
            target="_blank"
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="flex flex-col md:flex-row justify-between items-center gap-4 mt-16 pt-8"
    style={{ borderTop: "1px solid var(--sand-8)" }}
  >
    <span class="text-caption" style={{ color: "var(--sand)", opacity: 0.4 }}>
      &copy; {currentYear} Design Leaders
    </span>
    <span class="text-caption" style={{ color: "var(--sand)", opacity: 0.4 }}>
      Copenhagen, Denmark
    </span>
  </div>
</footer>
