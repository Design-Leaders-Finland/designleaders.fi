---
const navLinks = [
  { label: 'Work', href: '/#work' },
  { label: 'Services', href: '/services' },
  { label: 'Team', href: '/team' },
  { label: 'Apps', href: '/apps' },
  { label: 'Contact', href: '/contact' },
];

const { pathname } = Astro.url;
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="padding: 1.5rem 4vw;"
>
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="text-[var(--sand)] text-base font-medium tracking-tight"
      style="font-family: 'DM Sans', sans-serif;"
    >
      design leaders
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = link.href === pathname || (link.href.startsWith('/#') && pathname === '/');
        return (
          <a
            href={link.href}
            class="relative text-mono-label transition-opacity duration-300 hover:opacity-100"
            style={{
              color: 'var(--sand)',
              opacity: isActive ? 1 : 0.6,
              borderBottom: isActive && !link.href.startsWith('/#') ? '1px solid var(--amber)' : '1px solid transparent',
            }}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
    >
      <span
        id="hamburger-top"
        class="block w-5 h-px transition-transform duration-300"
        style={{ background: 'var(--sand)' }}
      />
      <span
        id="hamburger-middle"
        class="block w-5 h-px transition-opacity duration-300"
        style={{ background: 'var(--sand)' }}
      />
      <span
        id="hamburger-bottom"
        class="block w-5 h-px transition-transform duration-300"
        style={{ background: 'var(--sand)' }}
      />
    </button>
  </div>
</nav>

<!-- Mobile overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 hidden"
  style={{ background: 'rgba(5,5,5,0.95)' }}
>
  {navLinks.map((link) => (
    <a
      href={link.href}
      class="text-display-lg"
      style={{ color: 'var(--sand)' }}
    >
      {link.label}
    </a>
  ))}
</div>

<script>
  let scrolled = false;
  let menuOpen = false;
  
  const nav = document.getElementById('main-nav');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerTop = document.getElementById('hamburger-top');
  const hamburgerMiddle = document.getElementById('hamburger-middle');
  const hamburgerBottom = document.getElementById('hamburger-bottom');

  function updateNav() {
    const shouldBeScrolled = window.scrollY > window.innerHeight * 0.8;
    if (shouldBeScrolled !== scrolled) {
      scrolled = shouldBeScrolled;
      if (nav) {
        nav.style.backdropFilter = scrolled ? 'blur(8px)' : 'none';
        nav.style.background = scrolled ? 'rgba(5,5,5,0.7)' : 'transparent';
      }
    }
  }

  function toggleMenu() {
    menuOpen = !menuOpen;
    if (mobileMenu && hamburgerTop && hamburgerMiddle && hamburgerBottom) {
      if (menuOpen) {
        mobileMenu.classList.remove('hidden');
        hamburgerTop.style.transform = 'rotate(45deg) translateY(4px)';
        hamburgerMiddle.style.opacity = '0';
        hamburgerBottom.style.transform = 'rotate(-45deg) translateY(-4px)';
      } else {
        mobileMenu.classList.add('hidden');
        hamburgerTop.style.transform = 'none';
        hamburgerMiddle.style.opacity = '1';
        hamburgerBottom.style.transform = 'none';
      }
    }
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  mobileMenuBtn?.addEventListener('click', toggleMenu);
  
  // Close menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (menuOpen) toggleMenu();
    });
  });

  // Initial state
  updateNav();
</script>
