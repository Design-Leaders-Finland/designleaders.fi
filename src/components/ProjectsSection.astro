---
// Projects grid section - simplified from kimi_agent
const projects = [
  {
    title: "Fintech Design System",
    category: "Design Systems / Fintech",
    span: "col-span-full",
  },
  {
    title: "E-commerce Redesign",
    category: "Design Quality / E-commerce",
    span: "col-span-1",
  },
  {
    title: "Design Team Scaling",
    category: "Leadership / Enterprise",
    span: "col-span-1",
  },
  {
    title: "Brand Identity System",
    category: "Strategy / Brand",
    span: "col-span-1",
  },
  {
    title: "Product Redesign",
    category: "UX / SaaS",
    span: "col-span-1",
  },
];
---

<section
  id="work"
  style={{ background: "var(--surface)", padding: "6rem 8vw" }}
>
  <div class="flex items-end justify-between mb-12">
    <h2 class="text-display-lg" style={{ color: "var(--sand)" }}>
      Selected work
    </h2>
    <span
      class="text-mono-label hidden md:block"
      style={{ color: "var(--sand)", opacity: 0.4 }}
    >
      2019 — 2024
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {
      projects.map((project) => (
        <div
          class:list={[
            `group relative overflow-hidden cursor-pointer`,
            `${project.span}`,
          ]}
          style={{
            background: "var(--deep)",
            aspectRatio: project.span === "col-span-full" ? "2 / 1" : "1 / 1",
          }}
        >
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--void)] to-transparent opacity-60" />
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span
              class="text-mono-label block mb-2"
              style={{ color: "var(--clay)" }}
            >
              {project.category}
            </span>
            <h3 class="text-title" style={{ color: "var(--sand)" }}>
              {project.title}
            </h3>
          </div>
        </div>
      ))
    }
  </div>
</section>
