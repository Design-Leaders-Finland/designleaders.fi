---
// Projects grid section - simplified from kimi_agent
const projects = [
  {
    category: "Design Systems / Fintech",
    span: "col-span-full",
    title: "Fintech Design System",
  },
  {
    category: "Design Quality / E-commerce",
    span: "col-span-1",
    title: "E-commerce Redesign",
  },
  {
    category: "Leadership / Enterprise",
    span: "col-span-1",
    title: "Design Team Scaling",
  },
  {
    category: "Strategy / Brand",
    span: "col-span-1",
    title: "Brand Identity System",
  },
  {
    category: "UX / SaaS",
    span: "col-span-1",
    title: "Product Redesign",
  },
];
---

<section id="work" class="bg-surface pt-24 pb-24 px-[8vw]">
  <div class="flex items-end justify-between mb-12">
    <h2 class="text-display-lg text-sand">Selected work</h2>
    <span class="text-mono-label block text-sand opacity-70">
      2019 — 2024
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {
      projects.map((project) => (
        <div
          class:list={[
            `group relative overflow-hidden cursor-pointer bg-deep`,
            `${project.span}`,
            project.span === "col-span-full" ? "aspect-[2/1]" : "aspect-square",
          ]}
        >
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--void)] to-transparent opacity-60" />
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="text-mono-label block mb-2 text-clay">
              {project.category}
            </span>
            <h3 class="text-title text-sand">{project.title}</h3>
          </div>
        </div>
      ))
    }
  </div>
</section>
