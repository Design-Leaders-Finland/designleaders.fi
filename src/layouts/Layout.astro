---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="Design Leaders — Strategic Design & Product Studio" property="og:title" />
    <title>{title} — Design Leaders</title>
    <meta content="Jukka Paasonen" name="author" />
    <link href="/favicon.ico" rel="icon" />
    <meta content="/favicon.png" property="og:image" />
    <meta content="Strategic design and product studio crafting digital products for forward-thinking teams." property="og:description" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            // eslint-disable-next-line prefer-rest-params
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "redpng6bcj");
    </script>
  </head>

  <body>
    <Navigation />
    <slot />
    <Footer />
  </body>
</html>
